# ABRAM-DOCS — environment template.
# Names only, never values. Copy to .env.local and fill in; set the same
# names in the Vercel project environment.

# ── Supabase (this project's own, NOT abram-network's) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser, never in a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# ── Promotions proxy → abram-network ───────────────────────────────────────
# Presented to the `admin-promotions` edge function as x-abram-promo-token.
# Must match ABRAM_PROMO_ADMIN_TOKEN in that project's function secrets.
ABRAM_PROMO_ADMIN_TOKEN=
ABRAM_NETWORK_ANON_KEY=

# ── Collections sync ← abram-network ───────────────────────────────────────
# The shared secret abram-network signs each cash event with: HMAC-SHA256
# over `<timestamp>.<body>`, hex, in x-abram-sync-signature. Must match
# DOCS_COLLECTIONS_SYNC_SECRET in that project's function secrets.
#
# UNSET MEANS THE ENDPOINT REFUSES EVERYTHING (503). That is deliberate:
# /api/sync/collections writes the commission ledger, and an unsigned money
# endpoint is worse than a closed one. Rotation and replay:
# docs/plans/collections-sync.md
# Generate with: openssl rand -hex 32
DOCS_COLLECTIONS_SYNC_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ── Slack (KIPP's review channel) ──────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Mux (the demo videos at /demos) ────────────────────────────────────────
# Server-only, and the secret can delete every asset in the account — never
# a NEXT_PUBLIC_ name. Mux dashboard → Settings → Access Tokens, with the
# "Mux Video" permission. Unset means the console's file picker refuses and
# says so; everything else on that screen still works.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
